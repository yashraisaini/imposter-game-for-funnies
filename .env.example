# Optional but recommended for real deployments — without these, rooms are
# stored in memory and will NOT survive across serverless function instances
# on Vercel (fine for local dev / npm run dev, not fine for production).
# Free tier: https://upstash.com -> create a Redis database -> copy REST creds
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional and FREE — enables AI-generated word pairs for ANY topic the host
# types in. No credit card required. Without this, the game still works
# using the built-in curated word bank (custom topics fall back to a
# generic filler pair).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional but recommended for real deployments — without these, rooms are
# stored in memory and will NOT survive across serverless function instances
# on Vercel (fine for local dev / npm run dev, not fine for production).
# Free tier: https://upstash.com -> create a Redis database -> copy REST creds
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — enables AI-generated word pairs for ANY topic the host types in.
# Without this, the game still works using the built-in curated word bank.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
